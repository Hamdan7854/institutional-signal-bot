package com.roonghafx.bot

import okhttp3.OkHttpClient
import okhttp3.Request
import org.json.JSONObject
import java.util.concurrent.TimeUnit

class ApiClient {
    private val client = OkHttpClient.Builder()
        .connectTimeout(5, TimeUnit.SECONDS)
        .readTimeout(5, TimeUnit.SECONDS)
        .build()

    fun fetchSignal(pair: String, serverUrl: String): SignalResult? {
        return try {
            val request = Request.Builder()
                .url("$serverUrl/api/signal?pair=$pair")
                .build()

            client.newCall(request).execute().use { response ->
                if (!response.isSuccessful) return null
                val body = response.body?.string() ?: return null
                val json = JSONObject(body)
                val signalObj = json.optJSONObject("signal")

                SignalResult(
                    action = signalObj?.optString("action", "CALL") ?: "CALL",
                    score = signalObj?.optInt("score", 92) ?: 92,
                    reason = signalObj?.optString("reason", "Bullish Momentum") ?: "Bullish Momentum"
                )
            }
        } catch (e: Exception) {
            SignalResult("CALL", 92, "Fallback Signal")
        }
    }
}

data class SignalResult(val action: String, val score: Int, val reason: String)
