package com.roonghafx.bot

import android.graphics.Color
import android.os.CountDownTimer
import android.widget.TextView

class SignalScreen(
    private val tvAction: TextView,
    private val tvDetails: TextView,
    private val tvCountdown: TextView,
    private val tvStatus: TextView
) {

    fun showLoading(pair: String) {
        tvAction.text = "SCANNING..."
        tvAction.setTextColor(Color.YELLOW)
        tvDetails.text = "Checking Pocket Option candles for $pair"
        tvCountdown.text = "--"
        tvStatus.text = "Analyzing market indicators..."
    }

    fun renderSignal(signal: SignalResult, pair: String) {
        val isCall = signal.action.uppercase() == "CALL"
        tvAction.text = if (isCall) "🟢 CALL / UP" else "🔴 PUT / DOWN"
        tvAction.setTextColor(if (isCall) Color.GREEN else Color.RED)

        tvDetails.text = "Pair: $pair | Accuracy: ${signal.score}%\nReason: ${signal.reason}"
        
        startFiveSecondCountdown()
    }

    private fun startFiveSecondCountdown() {
        tvStatus.text = "GET READY ON POCKET OPTION!"
        
        object : CountDownTimer(5000, 1000) {
            override onTick(millisUntilFinished: Long) {
                val seconds = (millisUntilFinished / 1000) + 1
                tvCountdown.text = seconds.toString()
                tvCountdown.setTextColor(Color.parseColor("#59eb0b"))
            }

            override onFinish() {
                tvCountdown.text = "0"
                tvStatus.text = "🔥 PUT TRADE NOW ON POCKET OPTION! 🔥"
                tvStatus.setTextColor(Color.GREEN)
            }
        }.start()
    }
}
